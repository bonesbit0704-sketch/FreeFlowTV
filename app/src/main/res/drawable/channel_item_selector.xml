<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape>
            <gradient
                android:angle="0"
                android:endColor="#184363"
                android:startColor="#123246" />
            <corners android:radius="20dp" />
            <stroke
                android:width="2dp"
                android:color="@color/accent" />
        </shape>
    </item>
    <item android:state_activated="true">
        <shape>
            <solid android:color="@color/panel_bg_alt" />
            <corners android:radius="20dp" />
            <stroke
                android:width="2dp"
                android:color="@color/accent" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/panel_bg" />
            <corners android:radius="20dp" />
            <stroke
                android:width="1dp"
                android:color="@color/panel_line" />
        </shape>
    </item>
</selector>
